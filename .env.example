# Copy to .env.local for local development. In Vercel, set these under
# Project Settings > Environment Variables.

# Added automatically when you connect the Upstash Redis integration in Vercel.
# Leave blank locally to use a file-based store in .data/ instead.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Shared password for planner mode (tap the lock icon on the Home page).
PLANNER_PASSWORD=

# Long random string used to sign the planner cookie, e.g. `openssl rand -base64 32`.
SESSION_SECRET=

# Browser key with the Maps JavaScript API enabled. Restrict it to your site's domain.
NEXT_PUBLIC_GOOGLE_MAPS_KEY=

# Server key with the Geocoding API enabled. Can be the same key as above if that
# key isn't restricted by domain.
GOOGLE_GEOCODING_KEY=
